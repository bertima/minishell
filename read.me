void	update_all(t_shell *shell, char **av)
{
	int		i;

	i = 1;
	while (av[i])
	{
		if (ft_valid_expand(av[i][0]))
		{
			update(shell, av, i);
		}
		else
		{
			ft_putstr_fd("bash: export: '", 2);
			ft_putstr_fd(av[i], 2);
			ft_putstr_fd("': not a valid identifier\n", 2);
			shell->data->exit_code = 1;
		}
		i++;
	}
}